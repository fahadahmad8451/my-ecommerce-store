NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_VERSION=2026-07
# Private server-only token for the custom admin layer. Never prefix this with NEXT_PUBLIC.
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_api_access_token
# Shopify's stable API version used by the server-side Admin GraphQL client.
SHOPIFY_API_VERSION=2026-07
# Required in production to protect the custom admin and its APIs.
ADMIN_DASHBOARD_PASSWORD=replace_with_a_long_unique_admin_password
